  doi = {10.1128/genomeA.00522-14},
  issn = {, 2169-8287},
  language = {en},
  title = {{Draft Genome Sequence of Pseudomonas sp. Strain Ant30-3, a Psychrotolerant Bacterium with Biodegradative Attribute Isolated from Antarctica}},
  url = {http://genomea.asm.org/content/2/3/e00522-14},
  volume = {{2}},
  number = {3},
  urldate = {2014-08-26},
  journal = {{Genome Announc.}},
  author = {Koo H. and \textbf{Basu, M. K.} and Crowley M. and Aislabie J and Bej A. K.},
  month = jun,
  year = {2014},
  note = {PMID: 24903870},
  pages = {e00522-14},
  file = {Koo2014_Draft Genome Sequence of Pseudomonas sp.pdf:/Users/malay/m/etc/Firefox/Zotero/storage/PZ25SS58/Koo2014_Draft Genome Sequence of Pseudomonas sp.pdf:application/pdf}
}



